# ===================== 基金智能分析预测平台 环境配置 =====================
# 复制为 backend/.env 并按需修改。所有 Key 均不得写入源码。

# ---------- 应用 ----------
APP_NAME=基金智能分析预测平台
DEBUG=false

# ---------- 数据库（开发默认 SQLite；生产用 PostgreSQL）----------
# 开发: sqlite:///./fund.db
# 生产: postgresql+psycopg://fund:fund_password@postgres:5432/fund
DATABASE_URL=sqlite:///./fund.db
# 可选：Redis 缓存（留空使用本地 TTL 缓存）
REDIS_URL=

# ---------- 安全 ----------
# 生产环境务必修改为随机长字符串
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- DeepSeek LLM ----------
# 前往 https://platform.deepseek.com 获取。留空则聊天自动降级为量化引擎摘要。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# ---------- 数据源（按优先级排序，失败自动降级）----------
# eastmoney: 天天基金/东方财富公开接口（基金净值/估值/持仓/指数行情）
# mock:      离线演示数据（确定性生成，source=mock）
# custom:    用户自定义 JSON（backend/data/custom/）
DATA_PROVIDER_ORDER=eastmoney,mock
PROVIDER_TIMEOUT=12
PROVIDER_MAX_RETRIES=2
CACHE_TTL_SECONDS=300

# ---------- 定时同步 ----------
ENABLE_AUTO_SYNC=true
QUOTE_SYNC_MINUTES=5
DAILY_SYNC_TIME=08:00

# ---------- 演示数据 / 演示账号（首次启动自动创建）----------
SEED_DEMO_DATA=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123456
DEMO_EMAIL=demo@example.com

# ---------- 邮件通知（SMTP，留空则禁用）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true

# ---------- 预测引擎 ----------
MODEL_MIN_SAMPLES=300
MODEL_RETRAIN_DAYS=7
# 沙箱/受限环境用 1；生产可设 -1（使用全部核心）
MODEL_JOBS=1

# ---------- 存储与日志 ----------
STORAGE_DIR=storage
LOG_DIR=logs
LOG_LEVEL=INFO

# ---------- 前端跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
